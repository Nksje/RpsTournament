<Window x:Class="RpsTournament.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kivi-paber-käärid turniir" Height="520" Width="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Label Content="Mängija nimi:" VerticalAlignment="Center" />
            <TextBox x:Name="NameTextBox" Width="220" MaxLength="30" VerticalContentAlignment="Center" />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Vali käik" Padding="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RockRadio" Content="Kivi" GroupName="Move" Margin="0,0,24,0" />
                <RadioButton x:Name="PaperRadio" Content="Paber" GroupName="Move" Margin="0,0,24,0" />
                <RadioButton x:Name="ScissorsRadio" Content="Käärid" GroupName="Move" />
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="PlayButton" Content="Mängi vooru" Width="120" Height="30" Click="PlayButton_Click" />
            <Button x:Name="NewTournamentButton" Content="Uus turniir" Width="120" Height="30" Margin="12,0,0,0"
                    Click="NewTournamentButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="RoundTextBlock" FontWeight="Bold" Margin="0,0,24,0" />
            <TextBlock x:Name="ScoreTextBlock" FontWeight="Bold" />
        </StackPanel>

        <DataGrid Grid.Row="4" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Voor" Binding="{Binding Number}" Width="60" />
                <DataGridTextColumn Header="Mängija" Binding="{Binding PlayerMoveText}" Width="*" />
                <DataGridTextColumn Header="Arvuti" Binding="{Binding ComputerMoveText}" Width="*" />
                <DataGridTextColumn Header="Tulemus" Binding="{Binding ResultText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
